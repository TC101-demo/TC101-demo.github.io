---
layout: layouts/base.njk
---
{% set topicParts = topic | topic_path %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": title,
  "description": (description or title),
  "datePublished": (submission_date | date_iso),
  "version": (version | string),
  "keywords": keywords,
  "license": (license.url_terms if license),
  "identifier": (license.identifier if license),
  "creator": authors
} | json | safe }}
</script>

<article class="entry entry--dataset" itemscope itemtype="http://schema.org/Dataset" data-pagefind-filter="kind:dataset, topic_top:{{ topic | topic_top }}, license_family:{{ license | license_family }}, publication:{{ publication or 'none' }}">
  <header class="entry__header">
    <p class="entry__kind">
      <span class="pill pill--dataset">Dataset</span>
      {% if publication %}<span class="pill pill--publication">{{ publication | replace('_', ' ') | upper }}</span>{% endif %}
    </p>
    <h1 class="entry__title" itemprop="name">{{ title }}</h1>

    <nav class="breadcrumb" aria-label="Topic">
      {% for part in topicParts %}
        <span>{{ part }}</span>{% if not loop.last %}<span aria-hidden="true"> :: </span>{% endif %}
      {% endfor %}
    </nav>

    {% if thumbnail %}
      <img class="entry__thumbnail" src="{{ thumbnail | url }}" alt="Illustration of {{ title }}" loading="lazy" />
    {% endif %}

    <dl class="entry__meta">
      <dt>Submitted</dt>
      <dd><time datetime="{{ submission_date | date_iso }}" itemprop="datePublished">{{ submission_date | date_human }}</time></dd>
      <dt>Version</dt>
      <dd><span itemprop="version">{{ version }}</span></dd>
      {% if license %}
        <dt>License</dt>
        <dd>
          <a href="{{ license.url_terms }}" itemprop="license">{{ license.name }}</a>
          {% if license.identifier %}
            (<a href="https://spdx.org/licenses/{{ license.identifier }}.html">{{ license.identifier }}</a>)
          {% endif %}
        </dd>
      {% endif %}
      <dt>Authors</dt>
      <dd>
        <ul class="author-list">
          {% for author in authors %}
            <li itemprop="creator" itemscope itemtype="http://schema.org/Person">
              <span itemprop="name">{{ author.name }}</span>
              {% if author.affiliation %}<span class="muted">– {{ author.affiliation }}</span>{% endif %}
              {% if author.email %}<a href="mailto:{{ author.email | replace('(at)', '@') }}">[email]</a>{% endif %}
              {% if author.website %}<a href="{{ author.website }}">[website]</a>{% endif %}
              {% if author.orcid %}<a href="https://orcid.org/{{ author.orcid }}">[ORCID]</a>{% endif %}
            </li>
          {% endfor %}
        </ul>
      </dd>
      {% if keywords %}
        <dt>Keywords</dt>
        <dd>
          <ul class="keyword-list" itemprop="keywords">
            {% for kw in keywords %}<li>{{ kw }}</li>{% endfor %}
          </ul>
        </dd>
      {% endif %}
    </dl>
  </header>

  {% if downloads %}
    <section class="downloads" aria-labelledby="downloads-h">
      <h2 id="downloads-h">Downloads</h2>
      <table class="downloads__table">
        <thead>
          <tr>
            <th scope="col">File</th>
            <th scope="col">Type</th>
            <th scope="col">Size</th>
            <th scope="col">Mirrors</th>
          </tr>
        </thead>
        <tbody>
          {% for file in downloads %}
            <tr>
              <td>
                <a class="downloads__filename" href="{{ file.urls[0] }}">{{ file.filename }}</a>
                {% if file.description %}<div class="muted">{{ file.description }}</div>{% endif %}
                {% if file.md5sum %}<div class="muted small">md5: <code>{{ file.md5sum }}</code></div>{% endif %}
                {% if file.sha256sum %}<div class="muted small">sha256: <code>{{ file.sha256sum }}</code></div>{% endif %}
              </td>
              <td><span class="pill pill--type">{{ file.type }}</span></td>
              <td>{{ file.dl_size or '—' }}</td>
              <td>
                {% for url in file.urls %}
                  <a class="btn btn--small" href="{{ url }}" rel="external">Mirror {{ loop.index }}</a>
                {% endfor %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  {% endif %}

  <section class="entry__body" itemprop="description">
    <h2>Description</h2>
    {{ content | safe }}
  </section>

  <footer class="entry__footer">
    <p class="muted small">
      Found an issue (broken mirror, missing field)? Open an
      <a href="{{ site.repo }}/issues/new?labels=catalog&amp;title=Issue%20with%20{{ title | urlencode }}">issue on GitHub</a>.
    </p>
  </footer>
</article>
