{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tc101-demo.github.io/schemas/dataset.schema.json",
  "title": "IAPR TC10/11 Dataset Entry",
  "description": "Schema for the YAML front-matter of a dataset entry under src/content/datasets/.",
  "type": "object",
  "required": [
    "layout",
    "kind",
    "title",
    "submission_date",
    "version",
    "topic",
    "authors",
    "license",
    "downloads"
  ],
  "additionalProperties": true,
  "properties": {
    "layout": { "const": "layouts/dataset.njk" },
    "kind": { "const": "dataset" },
    "title": { "type": "string", "minLength": 3, "maxLength": 250 },
    "submission_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO-8601 date YYYY-MM-DD."
    },
    "version": { "type": ["string", "number"] },
    "topic": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 ,/&()'+.-]+(?:::[A-Za-z0-9 ,/&()'+.-]+)*$",
      "description": "Hierarchical topic, '::'-separated, from data/topics.yml."
    },
    "publication": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9]{4}$",
      "description": "Publication id from data/publications.yml (e.g. icdar_2021)."
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "email": { "type": "string" },
          "affiliation": { "type": "string" },
          "website": { "type": "string", "format": "uri" },
          "orcid": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["identifier", "name"],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string",
          "description": "SPDX identifier; see https://spdx.org/licenses/"
        },
        "name": { "type": "string" },
        "url_terms": { "type": "string", "format": "uri" }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "downloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filename", "urls", "type"],
        "additionalProperties": false,
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "urls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri" }
          },
          "type": {
            "enum": ["dataset", "code", "paper", "tool", "model", "other"]
          },
          "dl_size": { "type": "string" },
          "description": { "type": "string" },
          "md5sum": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "sha256sum": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "doi": { "type": "string" }
        }
      }
    },
    "doi": { "type": "string" },
    "thumbnail": { "type": "string" },
    "excerpt_separator": { "type": "string" },
    "data_format": {
      "type": "object",
      "description": "Structured description of the dataset's record format. Designed to help readers write data loaders.",
      "additionalProperties": false,
      "properties": {
        "file_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Concrete file extensions / formats actually present, e.g. PNG, JPEG, PDF, INKML, JSON, PAGE-XML, ALTO-XML, hOCR, COCO-JSON."
        },
        "annotation_standard": {
          "type": "string",
          "description": "Canonical annotation standard if any (PAGE-XML, ALTO-XML, COCO, PASCAL-VOC, hOCR, INKML, custom)."
        },
        "gt_tasks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "DIAR tasks the ground truth is suitable for (OCR, HTR, layout-analysis, baseline-detection, table-recognition, formula-recognition, KIE, DocVQA, ...)."
        },
        "splits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "size": { "type": ["integer", "string"] },
              "unit": { "type": "string", "description": "e.g. pages, lines, samples" }
            }
          }
        },
        "directory_structure": {
          "type": "string",
          "description": "Multi-line preformatted snippet showing the layout of the archive."
        },
        "record": {
          "type": "string",
          "description": "Short prose description of what one logical record / sample contains."
        },
        "loaders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "framework": { "type": "string", "description": "e.g. PyTorch, HuggingFace datasets, TensorFlow, plain Python" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
