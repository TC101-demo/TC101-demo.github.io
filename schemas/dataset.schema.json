{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tc101-demo.github.io/schemas/dataset.schema.json",
  "title": "IAPR TC10/11 Dataset Entry",
  "description": "Schema for the YAML front-matter of a dataset entry under src/content/datasets/.",
  "type": "object",
  "required": [
    "layout",
    "kind",
    "title",
    "submission_date",
    "version",
    "topic",
    "authors",
    "license",
    "downloads"
  ],
  "additionalProperties": true,
  "properties": {
    "layout": { "const": "layouts/dataset.njk" },
    "kind": { "const": "dataset" },
    "title": { "type": "string", "minLength": 3, "maxLength": 250 },
    "submission_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO-8601 date YYYY-MM-DD."
    },
    "version": { "type": ["string", "number"] },
    "topic": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 ,/&()'+.-]+(?:::[A-Za-z0-9 ,/&()'+.-]+)*$",
      "description": "Hierarchical topic, '::'-separated, from data/topics.yml."
    },
    "publication": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9]{4}$",
      "description": "Publication id from data/publications.yml (e.g. icdar_2021)."
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "email": { "type": "string" },
          "affiliation": { "type": "string" },
          "website": { "type": "string", "format": "uri" },
          "orcid": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["identifier", "name"],
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string",
          "description": "SPDX identifier; see https://spdx.org/licenses/"
        },
        "name": { "type": "string" },
        "url_terms": { "type": "string", "format": "uri" }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "downloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filename", "urls", "type"],
        "additionalProperties": false,
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "urls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri" }
          },
          "type": {
            "enum": ["dataset", "code", "paper", "tool", "model", "other"]
          },
          "dl_size": { "type": "string" },
          "description": { "type": "string" },
          "md5sum": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "sha256sum": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "doi": { "type": "string" }
        }
      }
    },
    "doi": { "type": "string" },
    "thumbnail": { "type": "string" },
    "excerpt_separator": { "type": "string" }
  }
}
