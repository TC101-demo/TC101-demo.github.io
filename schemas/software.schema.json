{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tc101-demo.github.io/schemas/software.schema.json",
  "title": "IAPR TC10/11 Software Entry",
  "description": "Schema for the YAML front-matter of a software entry under src/content/software/.",
  "type": "object",
  "required": [
    "layout",
    "kind",
    "title",
    "submission_date",
    "topic",
    "authors",
    "license",
    "repository_url"
  ],
  "additionalProperties": true,
  "properties": {
    "layout": { "const": "layouts/software.njk" },
    "kind": { "const": "software" },
    "title": { "type": "string", "minLength": 3, "maxLength": 250 },
    "submission_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "version": { "type": ["string", "number"] },
    "topic": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 ,/&()'+.-]+(?:::[A-Za-z0-9 ,/&()'+.-]+)*$"
    },
    "publication": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9]{4}$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "email": { "type": "string" },
          "affiliation": { "type": "string" },
          "website": { "type": "string", "format": "uri" },
          "orcid": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["identifier", "name"],
      "additionalProperties": false,
      "properties": {
        "identifier": { "type": "string" },
        "name": { "type": "string" },
        "url_terms": { "type": "string", "format": "uri" }
      }
    },
    "repository_url": { "type": "string", "format": "uri" },
    "homepage_url": { "type": "string", "format": "uri" },
    "package_url": {
      "type": "string",
      "format": "uri",
      "description": "e.g. PyPI, crates.io, npm, Maven Central"
    },
    "language": {
      "type": "array",
      "items": { "type": "string" }
    },
    "maintenance_status": {
      "enum": ["active", "maintained", "stale", "archived", "unknown"]
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "related_datasets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "thumbnail": { "type": "string" }
  }
}
